# Neon PostgreSQL — use the pooled connection string from the Neon dashboard.
# Host should include "-pooler" (e.g. ep-xxx-pooler.us-east-1.aws.neon.tech).
# Use sslmode=verify-full (or sslmode=require — normalized automatically).
# Example (omit channel_binding — it can cause node-pg timeouts with Neon pooler):
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
# Use https:// for production. Mobile camera access on a phone requires HTTPS
# (or localhost on the device). LAN dev over http://192.168.x.x will block the camera.
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional — Google works when set; Apple requires all three + flag)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Resend
RESEND_API_KEY=
EMAIL_FROM=Aurora Organics <onboarding@resend.dev>

# Scans & admin bootstrap
FREE_STARTER_SCANS=1
PRICING_MARGIN_BPS=2000
TARGET_MARGIN_BPS=7000
GEMINI_API_KEY=
BOOTSTRAP_ADMIN_EMAIL=

# WooCommerce catalog sync (optional — falls back to scripts/data/products_fallback.json).
# Consumer key/secret need Read/Write access for the affiliate feature to
# create coupons (WooCommerce → Settings → Advanced → REST API).
WOOCOMMERCE_STORE_URL=https://www.auroraorganics.co
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Must match the secret typed into the "Order updated" webhook created in
# WooCommerce → Settings → Advanced → Webhooks.
WOOCOMMERCE_WEBHOOK_SECRET=

# Secures /api/cron/* routes (Vercel Cron sends Authorization: Bearer <secret>)
CRON_SECRET=

# Payments. `mock` simulates the gateway end to end, no money moves.
# Set to `stripe` once the keys below are filled in.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=USD
MOCK_PAYMENT_DELAY_MS=800

# Stripe — test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`,
# or the signing secret shown for the endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Daily.co — video rooms for expert consultations. https://dashboard.daily.co/developers
DAILY_API_KEY=

# White-label tenants. The apex domain clinic subdomains hang off, e.g.
# "aurora.app" serves a clinic at "welldermclinic.aurora.app". Requires a
# wildcard DNS record (*.aurora.app) and a wildcard domain on the host.
# Leave blank in local development: *.localhost resolves to 127.0.0.1 in
# browsers with no hosts-file entry, so http://someclinic.localhost:3000 works.
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=
