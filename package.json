{
  "name": "aura",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test lib/**/*.test.ts lib/**/**/*.test.ts",
    "gen:icons": "npx tsx scripts/generate-pwa-icons.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed-admin": "npx tsx scripts/seed-admin.ts",
    "db:seed-products": "npx tsx scripts/seed-products.ts",
    "db:sync-products": "npx tsx scripts/sync-products.ts",
    "db:seed-ingredients": "npx tsx scripts/seed-ingredients.ts",
    "db:seed-rates": "npx tsx scripts/seed-model-rates.ts",
    "db:seed-packs": "npx tsx scripts/seed-scan-packs.ts",
    "db:reset-domain": "npx tsx scripts/reset-domain-data.ts",
    "db:backfill-ai-usage": "npx tsx scripts/backfill-ai-usage.ts",
    "eval": "npx tsx evals/run.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@google/genai": "^2.10.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.1.0",
    "recharts": "^3.8.0",
    "resend": "^6.17.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
